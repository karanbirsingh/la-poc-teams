# Logic App Okta Easy Auth Configuration
# Use this file with VS Code REST Client extension to configure Easy Auth manually

# =============================================================================
# Variables - Update these before running
# =============================================================================
@oktaDomain = integrator-7620286.okta.com
@oktaClientId = 0oazoxkr5qr5bSJFs697
@subscriptionId = 3019d4d5-a172-4635-877f-9ad4001cfa85
@resourceGroupName = karansin
@logicAppName = okta-easyauth-logicapp

# Get access token: az account get-access-token --query accessToken -o tsv
@accessToken = YOUR_ACCESS_TOKEN_HERE

# =============================================================================
# Step 1: Add OKTA_CLIENT_SECRET to Logic App App Settings
# =============================================================================
# Run this in terminal instead:
# az logicapp config appsettings set --name {{logicAppName}} --resource-group {{resourceGroupName}} --settings "OKTA_CLIENT_SECRET=your-okta-secret"

# =============================================================================
# Step 2: Configure Easy Auth with Okta as Custom OIDC Provider
# =============================================================================

### Configure Okta Easy Auth
PUT https://management.azure.com/subscriptions/{{subscriptionId}}/resourceGroups/{{resourceGroupName}}/providers/Microsoft.Web/sites/{{logicAppName}}/config/authsettingsV2?api-version=2024-04-01
Content-Type: application/json
Authorization: Bearer {{accessToken}}

{
    "id": "/subscriptions/{{subscriptionId}}/resourceGroups/{{resourceGroupName}}/providers/Microsoft.Web/sites/{{logicAppName}}/config/authsettingsV2",
    "name": "authsettingsV2",
    "type": "Microsoft.Web/sites/config",
    "properties": {
        "platform": {
            "enabled": true,
            "runtimeVersion": "~1"
        },
        "globalValidation": {
            "requireAuthentication": true,
            "unauthenticatedClientAction": "RedirectToLoginPage",
            "redirectToProvider": "okta1test",
            "excludedPaths": [
                "/runtime/*"
            ]
        },
        "identityProviders": {
            "customOpenIdConnectProviders": {
                "okta1test": {
                    "registration": {
                        "clientId": "{{oktaClientId}}",
                        "clientCredential": {
                            "clientSecretSettingName": "OKTA_CLIENT_SECRET"
                        },
                        "openIdConnectConfiguration": {
                            "authorizationEndpoint": "https://{{oktaDomain}}/oauth2/default/v1/authorize",
                            "tokenEndpoint": "https://{{oktaDomain}}/oauth2/default/v1/token",
                            "issuer": "https://{{oktaDomain}}/oauth2/default",
                            "certificationUri": "https://{{oktaDomain}}/oauth2/default/v1/keys"
                        }
                    },
                    "login": {
                        "nameClaimType": "sub",
                        "scopes": [
                            "openid",
                            "profile",
                            "email"
                        ]
                    }
                }
            }
        },
        "login": {
            "tokenStore": {
                "enabled": true,
                "tokenRefreshExtensionHours": 72.0
            },
            "preserveUrlFragmentsForLogins": false,
            "cookieExpiration": {
                "convention": "FixedTime",
                "timeToExpiration": "08:00:00"
            },
            "nonce": {
                "validateNonce": true,
                "nonceExpirationInterval": "00:05:00"
            }
        },
        "httpSettings": {
            "requireHttps": true,
            "routes": {
                "apiPrefix": "/.auth"
            },
            "forwardProxy": {
                "convention": "NoProxy"
            }
        }
    }
}

###

# =============================================================================
# Step 3: Verify Easy Auth Configuration
# =============================================================================

### Get Current Auth Settings
GET https://management.azure.com/subscriptions/{{subscriptionId}}/resourceGroups/{{resourceGroupName}}/providers/Microsoft.Web/sites/{{logicAppName}}/config/authsettingsV2?api-version=2024-04-01
Authorization: Bearer {{accessToken}}

###

# =============================================================================
# Notes
# =============================================================================
# 
# After configuring Easy Auth:
# 
# 1. Add this redirect URI to your Okta application:
#    https://<logic-app-name>.azurewebsites.net/.auth/login/okta1test/callback
#
# 2. The Easy Auth provider is named "okta1test" - this is referenced in:
#    - redirectToProvider setting
#    - callback URL path
#
# 3. The bot passes the Okta token via "x-ms-obo-usertoken" header
#    Easy Auth validates this token against Okta's JWKS endpoint
#
# 4. When authenticated, Easy Auth injects these headers:
#    - X-MS-CLIENT-PRINCIPAL-NAME: User's sub claim
#    - X-MS-CLIENT-PRINCIPAL-ID: User's ID
#    - X-MS-CLIENT-PRINCIPAL: Base64 encoded claims
#
# Architecture:
#   Teams User -> Azure Bot Service -> Bot Backend -> Logic App (Easy Auth)
#                      |                   |              |
#                      v                   v              v
#                    Okta            Gets Okta       Validates
#                   (OAuth)          Token via       Token via
#                                    AutoSignIn     Easy Auth
