{
  "_comment": "This is a TEMPLATE. Run deploy-phase1.ps1 from config/okta-only/ to generate appsettings.local.json with your actual values.",
  
  "Okta": {
    "Domain": "{{OKTA_DOMAIN}}",
    "ConnectionName": "okta",
    "AuthorizationServer": "default"
  },
  "TokenValidation": {
    "Enabled": true,
    "Audiences": [
      "{{BOT_APP_ID}}"
    ],
    "TenantId": "{{AZURE_TENANT_ID}}"
  },
  "AgentApplication": {
    "StartTypingTimer": true,
    "RemoveRecipientMention": false,
    "NormalizeMentions": false,
    "UserAuthorization": {
      "DefaultHandlerName": "auto",
      "AutoSignin": true,
      "Handlers": {
        "auto": {
          "Settings": {
            "AzureBotOAuthConnectionName": "okta",
            "Title": "Sign in with Okta",
            "Text": "Please sign in with your Okta account."
          }
        }
      }
    }
  },
  "Connections": {
    "ServiceConnection": {
      "Settings": {
        "AuthType": "ClientSecret",
        "ClientId": "{{BOT_APP_ID}}",
        "TenantId": "{{AZURE_TENANT_ID}}",
        "ClientSecret": "{{BOT_APP_SECRET}}",
        "Scopes": [ "https://api.botframework.com/.default" ]
      }
    }
  },
  "ConnectionsMap": [
    {
      "ServiceUrl": "*",
      "Connection": "ServiceConnection"
    }
  ],
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Agents": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
